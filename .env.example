# Frontend local development
# VITE_API_BASE=http://127.0.0.1:8000

# Backend CORS allowlist. Comma-separated origins.
VULNGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set this only when running behind a trusted reverse proxy that rewrites
# x-forwarded-for / x-real-ip correctly.
VULNGUARD_TRUST_PROXY=false
